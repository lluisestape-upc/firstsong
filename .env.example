# Copy to .env and fill in. .env is gitignored.

# https://platform.tripo3d.ai  -> API keys
TRIPO_API_KEY=
# v3.1-20260211 | v3.0-20250812 | Turbo-v1.0-20250506 | P1-20260311
# Note: Tripo API V2 endpoints retire 2026-11-01, model_version selects v3.
TRIPO_MODEL_VERSION=v3.1-20260211

# Leave empty to use the procedural environment.
WORLDLABS_API_KEY=
WORLDLABS_ENDPOINT=

DEMUCS_MODEL=htdemucs
